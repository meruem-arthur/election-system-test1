# ============================================================
# DEPARTMENTAL SMART ELECTION SYSTEM - ENVIRONMENT VARIABLES
# ============================================================

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/election_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=election_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio (SMS OTP) — Africa's Talking alternative below
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking (SMS — recommended for Ghana)
AT_API_KEY=your_at_api_key
AT_USERNAME=your_at_username
AT_SENDER_ID=ELECTION

# Email (SendGrid or SMTP)
EMAIL_PROVIDER=smtp  # or 'sendgrid'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@election.edu.gh
FROM_NAME=Departmental Smart Election System

# SendGrid (alternative)
SENDGRID_API_KEY=your_sendgrid_key

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# File Upload
MAX_CSV_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5
